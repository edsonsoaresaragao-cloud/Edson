# Optional self-hosted production storage only:
STORAGE_DOMAIN=
# Local development settings (never expose the dev emulator):
DEV_STORAGE_DIRECTORY=/workspace/.cache/edson-storage
DEV_STORAGE_HOST=127.0.0.1

# Optional: override the confirmed public donation recipient using all three fields.
# Leave all three empty to use Edson Aragão / Fortaleza / +5585981408606.
# The override phone must already be a registered Pix key.
PIX_PHONE=
PIX_BENEFICIARY=
PIX_CITY=

# Server-only product search integrations. Configure at least one to show live offers.
# SerpApi connects Google Shopping; Brave adds product pages and descriptions.
PARTS_SERPAPI_KEY=
PARTS_BRAVE_API_KEY=
# Shared persistent API-call budgets; cache hits do not consume these budgets.
PARTS_MONTHLY_API_LIMIT=100
PARTS_DAILY_API_LIMIT=50
PARTS_SEARCH_CACHE_SECONDS=900

# Technical automotive search: configure Google (both fields) OR Brave.
# Server only. Never prefix these keys with NEXT_PUBLIC_.
AUTOMOTIVE_GOOGLE_API_KEY=
AUTOMOTIVE_GOOGLE_CX=
AUTOMOTIVE_BRAVE_API_KEY=
# Optional grounded synthesis. Without this key the source results still work.
OPENAI_API_KEY=
AUTOMOTIVE_AI_MODEL=gpt-4.1-mini
# Official YouTube search uses YOUTUBE_API_KEY above.
AUTOMOTIVE_CACHE_SECONDS=900
# Shared budgets count actual outgoing API calls, including web/image separately.
AUTOMOTIVE_WEB_DAILY_LIMIT=60
AUTOMOTIVE_WEB_MONTHLY_LIMIT=500
AUTOMOTIVE_AI_DAILY_LIMIT=20
AUTOMOTIVE_YOUTUBE_DAILY_SEARCHES=5
